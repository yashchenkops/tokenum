<style lang="scss">
  @use '@/styles/base/variables' as v;

  :global(.page-section--hero .page-section__inner) {
    position: relative;
    padding-top: 200px;
    padding-bottom: 130px;
  }

  .section-title {
    text-transform: uppercase;
  }

  .hero__info {
    max-width: 787px;
  }

  .hero__description {
    font-weight: 400;
    font-size: 32px;
    line-height: 110%;
    color: rgba(21, 21, 21, 0.6);
    margin-bottom: 64px;
  }

  .section-title {
    margin-bottom: 48px;
  }

  .hero__actions {
    display: flex;
    gap: 35px;
    max-width: 720px;
    margin-bottom: 64px;
  }

  .hero__social-x,
  .hero__social-instagram,
  .hero__social-facebook {
    svg {
      transition: all 0.3s ease;
    }

    &:hover {
      svg {
        scale: 1.1;
      }
    }
  }

  .hero__decoration {
    position: absolute;
    top: -95px;
    right: -145px;
    z-index: -1;
  }
</style>