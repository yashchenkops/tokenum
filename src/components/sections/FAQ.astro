---
import Section from '../modules/Section/index.astro'; 
import SectionTitle from '../modules/SectionTitle.astro';

const faqInfo = [
  {
    title: 'How do I start exchanging fiat for crypto on Tokenum?',
    description: 'Click "Sign Up", confirm your email, and complete a quick verification. Once verified, you can exchange fiat for crypto directly on the platform — in seconds.'
  },
  {
    title: 'What does the account verification process involve?',
    description: 'We collect your full name, date of birth, phone number, and email to verify your identity. For higher-volume activity, we may also ask for proof of address or source of funds as part of our compliance process'
  },
  {
    title: 'What documents are accepted for identity and address verification?',
    description: `Proof of Identity: passport, national ID card, driver's license, or residence permit — must be in color and clearly show your full name. Proof of Address: utility bill, bank statement, or tax document issued within the last 3 months — showing your name, address, and date.`
  },
  {
    title: 'Does Tokenum have a license and comply with regulations?',
    description: 'Yes. Tokenum is a registered Canadian company holding an MSB (Money Services Business) license, authorizing us to provide cryptocurrency exchange services in full regulatory compliance.'
  },
  {
    title: 'How are my funds protected on the platform?',
    description: 'Tokenum uses multi-layer encryption and strict internal security protocols. Every transaction is monitored in real time, and your funds are never held longer than necessary.'
  },
  {
    title: 'What currencies and cryptocurrencies are supported?',
    description: 'We currently support Bitcoin (BTC), Ethereum (ETH), and USD Coin (USDC), with fiat pairs including EUR and USD. More assets are being added regularly.'
  },
  {
    title: 'How can I reach the support team if something goes wrong?',
    description: 'Reach our team by emailing support@tokenum.io or by submitting a request directly in your account under the Support tab.'
  },
]

const middleIndex = Math.ceil(faqInfo.length / 2);
const firstColumn = faqInfo.slice(0, middleIndex);
const secondColumn = faqInfo.slice(middleIndex);
---
<script>
  const faqItem = document.querySelectorAll('.faq__card');

  faqItem.forEach(item => {
    item.addEventListener('click', () => {
      const isActive = item.classList.contains('is-active');

      faqItem.forEach(item => {
        item.classList.remove('is-active');
      })
      
      if (!isActive) {
        item.classList.add('is-active')
      }
      
    })
  })
</script>

<Section class="faq" id="faq">
  <div class="faq__info">
    <SectionTitle as="h2" size="medium" tone="dark">what PEOPLE<br />are Asking</SectionTitle>
  </div>
  <div class="faq__cards">
    <div class="faq__cards">
      <div class="faq__column" data-aos="fade-down">
        {firstColumn.map(card => (
          <div class="faq__card">
            <div class="faq__card-info">
              <h3 class="faq__card-title">{card.title}</h3>
              <p class="faq__card-description">{card.description}</p>
            </div>
            <div class="faq__card-arrow">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M18.2 1.2002L1.19995 18.2002M18.1985 18.2002L1.19995 18.2002L1.19995 1.20019" stroke="#151515" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
          </div>
        ))}
      </div>
      <div class="faq__column" data-aos="fade-down">
        {secondColumn.map(card => (
          <div class="faq__card">
            <div class="faq__card-info">
              <h3 class="faq__card-title">{card.title}</h3>
              <p class="faq__card-description">{card.description}</p>
            </div>
            <div class="faq__card-arrow">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M18.2 1.2002L1.19995 18.2002M18.1985 18.2002L1.19995 18.2002L1.19995 1.20019" stroke="#151515" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</Section>

<style lang="scss">
  @use '@/styles/base/variables' as v;

  .page-section--faq {
    padding: 128px 0;
  }

  .section-title {
    text-transform: uppercase;
    margin-bottom: 64px;
  }

  .faq__cards {
    display: flex;
    gap: 30px;
  }

  .faq__card {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 30px;
    padding: 50px;
    border: 1px solid v.$black;
    transition: all 0.2s ease;
    cursor: pointer;

    &.is-active {
      background-color: v.$blue;
      border-color: v.$white;

      .faq__card-title {
        color: v.$white;
      }

      .faq__card-description {
        color: rgba(248, 248, 248, 0.6);
        max-height: 300px;
        opacity: 1;
        margin-top: 24px;
        color: rgba(248, 248, 248, 0.6);
        visibility: visible;
      }

      .faq__card-arrow {
        border-color: v.$white;

        svg {
          rotate: 180deg;
          transition: rotate 0.3s ease;

          path {
            stroke: v.$white;
          }
        }
      }
    }
  }

  .faq__card-info {
    max-width: 593px;
  }

  .faq__card-title {
    font-weight: 400;
    font-size: 48px;
    line-height: 110%;
    text-transform: capitalize;
    color: v.$black;
  }

  .faq__card-description {
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    margin-top: 0;

    font-size: 32px;
    line-height: 110%;

    transition:
      max-height 0.4s ease,
      opacity 0.3s ease,
      margin-top 0.3s ease;
  }

  .faq__card-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 54px;
    height: 54px;
    border: 1px solid v.$black;
    
    svg {
      transition: translate 0.2s ease;
    }
  }

  @media (max-width: v.$desktop) {
    .page-section--faq {
      padding-top: 100px;
    }

    .section-title {
      margin-bottom: 50px;
    }

    .faq__cards {
      gap: 20px;
    }

    .faq__card {
      padding: 30px;
      margin-bottom: 20px;
    }

    .faq__card-title {
      font-size: 38px;
    }

    .faq__card-description {
      font-size: 26px;
    }
  }

  @media (max-width: v.$tablet) {
    .page-section--faq {
      padding-top: 60px;
      padding-bottom: 60px;
    }

    .faq__card-title {
      font-size: 32px;
    }

    .faq__cards {
      flex-direction: column;
      gap: 0;
    }

    .faq__card-description {
      font-size: 22px;
    }

    .faq__card-arrow {
      width: 30px;
      height: 30px;

      svg {
        width: 12px;
      }
    }
  }

  @media (max-width: v.$mobile) {
    .page-section--faq {
      padding-top: 40px;
    }

    .section-title {
      margin-bottom: 30px;
    }

    .faq__card {
      padding: 15px;
    }

    .faq__card-title {
      font-size: 20px;
    }

    .faq__card-description {
      font-size: 18px;
    }
  }
</style>
