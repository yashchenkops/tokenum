---
const {
  as: Tag = 'h2',
  size = 'large',
  tone = 'dark',
  class: className = '',
  ...rest
} = Astro.props;
---

<Tag
  class:list={[
    'section-title',
    `section-title--${size}`,
    `section-title--${tone}`,
    className
  ]}
  {...rest}
>
  <slot />
</Tag>

<style lang="scss">
  @use '@/styles/base/variables' as v;

  .section-title {
    font-weight: 700;
    line-height: 95%;

    &--large {
      font-size: 96px;
    }

    &--medium {
      font-size: 64px;
    }

    &--light {
      background-clip: text;
      color: transparent;
      background-image: url("data:image/svg+xml,%3Csvg width='1034' height='163' viewBox='0 0 1034 163' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cellipse cx='519.562' cy='81.7344' rx='603' ry='213.5' fill='url(%23paint0_radial_45_81)' /%3E%3Cdefs%3E%3CradialGradient id='paint0_radial_45_81' cx='0' cy='0' r='1' gradientTransform='matrix(620.773 24.4199 -7.15582 219.793 519.563 81.7344)' gradientUnits='userSpaceOnUse'%3E%3Cstop offset='0.114801' stop-color='white' /%3E%3Cstop offset='1' stop-color='%23A4A4A4' /%3E%3C/radialGradient%3E%3C/defs%3E%3C/svg%3E");
      background-repeat: no-repeat;
      background-size: cover;
    }

    &--dark {
      color: v.$black;
      background: radial-gradient(50.03% 50.00% at 50.00%  50.00%, rgb(21, 21, 21) 41.27415120601654%, rgb(76, 76, 76) 100%);
      background-clip: text;
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
  }

  @media (max-width: v.$desktop-lg) {
    .section-title {
      &--large {
        font-size: 72px;
      }

      &--medium {
        font-size: 52px;
      }
    }
  }

  @media (max-width: v.$desktop) {
    .section-title {
      &--large {
        font-size: 52px;
      }

      &--medium {
        font-size: 46px;
      }
    }
  }

  @media (max-width: v.$tablet) {
    .section-title {
      &--large {
        font-size: 42px;
      }

      &--medium {
        font-size: 36px;
      }
    }
  }

  @media (max-width: v.$mobile) {
    .section-title {
      &--large {
        font-size: 32px;
      }

      &--medium {
        font-size: 28px;
      }
    }
  }
</style>