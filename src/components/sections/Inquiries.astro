---
import Button from '../modules/Button.astro';
import Section from '../modules/Section/index.astro'; 
import SectionTitle from '../modules/SectionTitle.astro';
---

<Section class="inquiries" id="inquiries" data-aos="fade-up">
  <SectionTitle as="h2" size="large" tone="light">Business inquiries</SectionTitle>
  <p class="inquiries__description">Dedicated to institutions and businesses interested in working with us.</p>
  <div class="inquiries__actions">
      <Button href="#" variant="outline-white">Get in touch</Button>
      <Button href="#" variant="white">Enter yout email</Button>
    </div>
</Section>

<style lang="scss">
  @use '@/styles/base/variables' as v;

  :global(.page-section--inquiries .page-section__inner) {
    background-color: v.$black;
    padding: 180px 160px 100px;
    border-top-right-radius: 100px;
    @include v.itemFigure();
  }

  .page-section--inquiries {
    padding-bottom: 150px;
    padding-left: 15px;
    padding-right: 15px;
  }

  .section-title {
    margin-bottom: 48px;
    max-width: 1000px;
  }

  .inquiries__description {
    font-size: 32px;
    line-height: 110%;
    color: v.$title-white;
    opacity: 0.6;
    margin-bottom: 64px;
  }

  .inquiries__actions {
    display: flex;
    align-items: center;
    gap: 42px;
  }

  @media (max-width: v.$desktop-lg) {
    .inquiries__description {
      font-size: 24px;
    }
  }

  @media (max-width: v.$desktop) {
    :global(.page-section--inquiries .page-section__inner) {
      padding: 100px 140px;
      border-top-right-radius: 80px;
      @include v.itemFigure($size: 50px);
    }

    .page-section--inquiries {
      padding-bottom: 100px;
    }

    .section-title {
      margin-bottom: 20px;
    }

    .inquiries__description {
      font-size: 18px;
      margin-bottom: 40px;
    }
  }

  @media (max-width: v.$tablet) {
    :global(.page-section--inquiries .page-section__inner) {
      padding: 50px;
      border-top-right-radius: 50px;
      @include v.itemFigure($size: 30px);
    }

    .inquiries__description {
      margin-bottom: 30px;
    }

    .inquiries__actions {
      gap: 15px;
    }
  }

  @media (max-width: v.$mobile) {
    :global(.page-section--inquiries .page-section__inner) {
      padding: 30px;
      border-top-right-radius: 30px;
      @include v.itemFigure($size: 15px);
    }

    .page-section--inquiries {
      padding-left: 0;
      padding-right: 0;
    }
  }
</style>