</FooterSection>

<style lang="scss">
  @use '@/styles/base/variables' as v;

  :global(.page-footer__inner) {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
  }

  .page-footer {
    padding: 116px 0px;
    background-color: v.$black;
    color: v.$white;
  }

  .footer-title {
    font-weight: 700;
    font-size: 20px;
    line-height: 115%;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    margin-bottom: 24px;
  }

  .footer-left {
    max-width: 305px;
  }
  
  .logo-footer {
    margin-bottom: 17px;
  }

  .footer-left-description {
    font-size: 16px;
    line-height: 100%;
    color: v.$title-white;
    margin-bottom: 17px;
  }
  
  .footer-left__socials {
    display: flex;
    align-items: center;
    gap: 30px;
    margin-bottom: 35px;
  }

  .footer-left__socials-items {
    display: flex;
    align-items: center;
    gap: 20px;
    transition: all 0.3s ease;
    
    a {
      &:hover {
        scale: 1.1;
      }
    }
  }

  .footer-center {
    max-width: 600px;
    width: 100%;
  }

  .footer-center_menu {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .footer-center_menu-col {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 150px;
    width: 100%;

    &:nth-child(2) {
      max-width: 240px;
    }

    &:nth-child(3) {
      max-width: 170px;
    }

    a {
      font-size: 18px;
      line-height: 125%;
      color: v.$title-white;
    }
  }

  .footer-right {
    max-width: 200px;
    width: 100%;
  }

  .footer-right__adress {
    display: flex;
    flex-direction: column;
    gap: 16px;

    a,
    address,
    time {
      font-size: 18px;
      line-height: 125%;
      color: v.$title-white;
      font-style: normal;
    }
  }

  @media (max-width: v.$desktop-lg) {
    .page-footer {
      padding: 80px 0px;
    }

    .footer-center {
      max-width: 470px;
    }

    .footer-center_menu-col {
      width: auto;
    }
  }

  @media (max-width: v.$desktop) {
    :global(.page-footer__inner) {
      flex-wrap: wrap;
      row-gap: 50px;
    }

    .footer-title {
      font-size: 18px;
    }

    .footer-center_menu-col {
      a {
        font-size: 14px;
      }
    }

    .footer-right {
      a,
      address,
      time {
        font-size: 14px;
      }
    }
  }
</style>