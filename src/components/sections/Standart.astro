---
import Button from '../modules/Button.astro';
import Section from '../modules/Section/index.astro'; 
import SectionTitle from '../modules/SectionTitle.astro';
---

<Section class="standart">
  <SectionTitle as="h2" size="large" tone="light">Not just an exchange.<br />A new standard.</SectionTitle>
  <p class="standart__description">We turn complex crypto into simple, instant trades. Switch between fiat and digital
currencies in seconds. Always transparent. Always secure.</p>
  <Button href="#" variant="white">read more about us</Button>
</Section>

<style lang="scss">
  @use '@/styles/base/variables' as v;

  :global(.page-section--standart .page-section__inner) {
    background-color: v.$black;
    padding: 180px 160px 100px;
    border-top-right-radius: 100px;
    @include v.itemFigure();
  }

  .page-section--standart {
    padding-left: 15px;
    padding-right: 15px;
    padding-bottom: 150px;
  }

  .section-title {
    margin-bottom: 48px;
    max-width: 1000px;
  }

  .standart__description {
    font-size: 32px;
    line-height: 1.3;
    color: v.$title-white;
    opacity: 0.6;
    margin-bottom: 64px;
  }

  @media (max-width: v.$desktop-lg) {
    :global(.page-section--standart .page-section__inner) {
      padding: 140px 140px 80px;
      border-top-right-radius: 80px;
      @include v.itemFigure($size: 80px);
    }

    .standart__description {
      font-size: 24px;
    }
  }

  @media (max-width: v.$desktop) {
    :global(.page-section--standart .page-section__inner) {
      padding: 80px 100px 60px;
      border-top-right-radius: 60px;
      @include v.itemFigure($size: 50px);
    }

    .section-title {
      margin-bottom: 20px;
    }

    .standart__description {
      font-size: 18px;
      margin-bottom: 30px;
    }

    .button {
      max-width: 240px;
    }
  }

  @media (max-width: v.$tablet) {
    :global(.page-section--standart .page-section__inner) {
      padding: 50px;
      border-top-right-radius: 30px;
      @include v.itemFigure($size: 30px);
    }

    .page-section--standart {
      padding-bottom: 80px;
    }

    .standart__description {
      font-size: 14px;
      margin-bottom: 30px;
    }
  }

  @media (max-width: v.$mobile) {
    :global(.page-section--standart .page-section__inner) {
      padding: 30px 30px 40px 35px;
      border-top-right-radius: 20px;
      @include v.itemFigure($size: 20px);
    }

    .page-section--standart {
      padding-left: 0;
      padding-right: 0;
    }

    .button {
      max-width: 160px;
    }
  }

</style>