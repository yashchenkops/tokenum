  <div class="exchange__top">
    <SectionTitle as="h2" size="medium" tone="light">crypto<br />Exchange</SectionTitle>
    <p class="exchange__description">Convert Bitcoin, Ethereum, and altcoins instantly—optimized for transparency and convenience.</p>
  </div>
  <div class="exchange__bottom">
