          </svg>
        </div>
        <div class="exchange__bottom-left-info">
          <p class="exchange__bottom-left-title">USDC</p>
          <p class="exchange__bottom-left-description">Usdc</p>
        </div>
      </div>
    </div>
    <div class="exchange__bottom-right">
      <Image class="exchange__bottom-right-coin" src={exchangeCoin} alt="Exchange coin"/>
      <div class="exchange__bottom-right-form">
        <h3 class="exchange__bottom-right-title">
          Exchange crypto instantly
        </h3>
        <div class="exchange__bottom-right-currency">
          <span class="currency-left currency-item">1 EURO (EUR)</span>
          <span class="currency-item">=</span>
          <span class="currency-right currency-item">0,00001193 Bitcoin (BTC)</span>
        </div>
        <input type="text" class="exchange__bottom-right-input" name="euro" placeholder="Enter amount in EUR">
        <input type="text" class="exchange__bottom-right-input" name="bitcoin" placeholder="Enter amount in Bitcoin">
      </div>
    </div>
  </div>
</Section>

<style lang="scss">
  @use '@/styles/base/variables' as v;

  .page-section--exchange {
    background-color: v.$black;
    padding: 128px 0 190px;
  }

  .exchange__top {
    margin-bottom: 64px;
  }

  .section-title {
    margin-bottom: 48px;
    max-width: 1000px;
    text-transform: uppercase;
  }

  .exchange__description {
    font-size: 32px;
    line-height: 110%;
    color: v.$title-white;
    opacity: 0.6;
    max-width: 665px;
  }

  .exchange__bottom {
    display: flex;
    justify-content: space-between;
    gap: 40px;
  }

  .exchange__bottom-left {
    background-color: v.$black;
    padding: 100px 140px;
    color: v.$title-white;
    border: 1px solid v.$white;
    border-radius: 0 60px 0 0;
    width: 50%;
    @include v.itemFigure($bg-color: v.$black, $size: 57px);

    &::before {
      border-top: 1px solid v.$black;
      border-left: 1px solid v.$black;
      border-right: 1px solid v.$white;
      border-bottom: 1px solid v.$white;
      left: -1px;
      top: -1px;
    }

    &::after {
      border-top: 1px solid v.$white;
    }
  }

  .exchange__bottom-left-item {
    display: flex;
    gap: 38px;

    &:not(:last-child) {
      margin-bottom: 30px;
    }
  }

  .exchange__bottom-left-icon {
    padding-top: 10px;
  }

  .exchange__bottom-left-title {
    font-weight: 700;
    font-size: 50px;
    line-height: 120%;
    color: v.$title-white;
    margin-bottom: 8px;
  }

  .exchange__bottom-left-description {
    font-size: 24px;
    line-height: 133%;
    color: v.$title-white;
    opacity: 0.6;
  }

  .exchange__bottom-right {
    width: 50%;
    padding: 113px 54px 96px 89px;
    border-radius: 0 60px 0 0;
    background-color: v.$blue;
    @include v.itemFigure($bg-color: v.$black, $size: 56px);
  }

  .exchange__bottom-right-coin {
    position: absolute;
    top: -83%;
  }

  .exchange__bottom-right-title {
    font-weight: 700;
    font-size: 42px;
    color: v.$title-white;
    margin-bottom: 18px;
  }

  .exchange__bottom-right-currency {
    margin-bottom: 75px;
  }

  .currency-item {
    font-weight: 400;
    font-size: 24px;
    color: v.$title-white;
  }

  .exchange__bottom-right-input {
    width: 100%;
    padding: 25px 30px;
    font-size: 25px;
    line-height: 90%;
    text-transform: capitalize;
    color: v.$title-black;
    outline: none;

    &:not(:last-child) {
      margin-bottom: 38px;
    }
  }
</style>