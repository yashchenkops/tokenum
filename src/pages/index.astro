---
import '@/styles/main.scss'
import Layout from '../layouts/Layout.astro';

import Header from '../components/sections/Header.astro';
import Hero from '../components/sections/Hero.astro';
import Standart from '../components/sections/Standart.astro';
import Trusted from '../components/sections/Trusted.astro';
import Benefits from '../components/sections/Benefits.astro';
import Freedom from '../components/sections/Freedom.astro';
import Exchange from '../components/sections/Exchange.astro';
import FAQ from '../components/sections/FAQ.astro';
import Inquiries from '../components/sections/Inquiries.astro';
import Footer from '../components/sections/Footer.astro';
import ArrowUp from '../components/modules/ArrowUp.astro';
---

<Layout>
	<Header />
	<main class="main">
		<Hero />
		<Standart />
		<Trusted />
		<Benefits />
		<Freedom />
		<Exchange />
		<FAQ />
		<Inquiries />
	</main>
	<Footer />
	
	<ArrowUp />
